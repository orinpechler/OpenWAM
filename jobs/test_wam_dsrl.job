#!/bin/bash
#SBATCH --job-name=test_wam_dsrl
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gpus=1
#SBATCH --cpus-per-task=18
#SBATCH --time=06:00:00
#SBATCH --output=jobs/logs/%x_%j.out

# Evaluate OpenWAM steered by a trained DSRL latent actor on one RoboTwin task, the
# same way OpenWAM itself is evaluated (robotwin_single_eval.job): starts
# dsrl/test_wam_dsrl.py as the policy server in the background, waits until its
# WebSocket port is open, then runs dsrl/data/robotwin/rollout.sh on the evaluation
# seeds (SEED=0, as single_eval.sh) with the DSRL client, which reports each
# episode's end so the server logs it. The client runs under jobs/sim_watchdog.sh,
# which restarts a hung simulator and resumes on the next seed. Results land in
# ${ROBOTWIN_PATH}/eval_result/ under ckpt_setting ${CKPT_SETTING}, one result dir
# per client attempt; the [WATCHDOG] lines give the total. Server and simulator
# share the single allocated GPU.
#
# Submit from the repo root:
#   POLICY_CKPT=/scratch-shared/$USER/dsrl/<date>/<time>/checkpoints/final.pt sbatch jobs/test_wam_dsrl.job
#   POLICY_CKPT=<entity>/openwam-dsrl/dsrl-agent-<run id>:final sbatch jobs/test_wam_dsrl.job
# EPISODES sets the number of evaluation episodes (default 50), e.g.
#   EPISODES=10 sbatch jobs/test_wam_dsrl.job
# Extra arguments are passed on to dsrl/test_wam_dsrl.py (e.g. --stochastic).

set -euo pipefail

ROBOTWIN_PATH="${ROBOTWIN_PATH:-/gpfs/home6/opechler/RoboTwin}"
ROBOTWIN_PYTHON="${ROBOTWIN_PYTHON:-/home/opechler/.conda/envs/robotwin/bin/python}"
CKPT_DIR="${CKPT_DIR:-/scratch-shared/opechler/openwam_ckpt/OpenWAM-Alpha-Sim-RoboTwin-Clean2Random}"   # trained on demo_clean only
POLICY_CKPT="${POLICY_CKPT:-/scratch-shared/opechler/dsrl/2026-10-04/13-34-13/checkpoints/final.pt}"
ENV_NAME="${ENV_NAME:-openwam}"
# Fixed on purpose (not read from the environment, which sbatch passes into the job):
# this job only ever runs adjust_bottle in RoboTwin's randomized setting. Edit here to change.
TASK="adjust_bottle"
TASK_CONFIG="demo_randomized"
CKPT_SETTING="${CKPT_SETTING:-dsrl}"       # label in RoboTwin's result paths
SERVER_TIMEOUT="${SERVER_TIMEOUT:-1800}"   # seconds to wait for model load
EPISODES="${EPISODES:-50}"                 # evaluation episodes (robotwin_single_eval.job also runs 50)

export ROBOTWIN_PATH ROBOTWIN_PYTHON
# Evaluation seeds and per-episode videos, as single_eval.sh.
export SEED=0 ROBOTWIN_EVAL_VIDEO="${ROBOTWIN_EVAL_VIDEO:-1}" CKPT_SETTING

cd "${SLURM_SUBMIT_DIR:-$(dirname "$0")/..}"
[[ -d "${CKPT_DIR}" ]] || { echo "[ERROR] CKPT_DIR not found: ${CKPT_DIR}" >&2; exit 1; }

# GPU nodes can be shared between jobs, so derive the port from the job id.
PORT=$((20000 + ${SLURM_JOB_ID:-0} % 20000))
HOST=127.0.0.1
SERVER_LOG="jobs/logs/${SLURM_JOB_NAME:-test_wam_dsrl}_${SLURM_JOB_ID:-local}_server.log"

module purge
module load 2025
module load Anaconda3/2025.06-1
# torch.compile (Triton) needs a C compiler at runtime.
module load GCC/14.2.0
# RoboTwin pipes eval videos through ffmpeg (eval_video_log in task_config).
module load FFmpeg/7.1.1-GCCcore-14.2.0

source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate "${ENV_NAME}"

# wandb's local files (staging of uploads, artifact cache and downloads) on shared scratch,
# not in $HOME or the repo.
WANDB_SCRATCH="/scratch-shared/${USER}/wandb"
export WANDB_DATA_DIR="${WANDB_SCRATCH}/data" WANDB_CACHE_DIR="${WANDB_SCRATCH}/cache" WANDB_ARTIFACT_DIR="${WANDB_SCRATCH}/artifacts"
mkdir -p "${WANDB_DATA_DIR}" "${WANDB_CACHE_DIR}" "${WANDB_ARTIFACT_DIR}"

echo "node         : $(hostname)"
echo "checkpoint   : ${CKPT_DIR}"
echo "policy       : ${POLICY_CKPT}"
echo "task         : ${TASK} (${TASK_CONFIG}), episodes=${EPISODES}"
echo "server       : ws://${HOST}:${PORT}, log=${SERVER_LOG}"
nvidia-smi --query-gpu=index,name,memory.total,driver_version --format=csv

# ── Steered policy server (background) ───────────────────────────────────────
PYTHONUNBUFFERED=1 python dsrl/test_wam_dsrl.py \
    --ckpt-dir "${CKPT_DIR}" --policy-ckpt "${POLICY_CKPT}" \
    --device cuda:0 --host "${HOST}" --port "${PORT}" \
    "$@" > "${SERVER_LOG}" 2>&1 &
server_pid=$!

cleanup() {
    kill "${server_pid}" 2>/dev/null || true
    wait "${server_pid}" 2>/dev/null || true
}
trap cleanup EXIT

echo "[INFO] Waiting for policy server (pid ${server_pid}) on port ${PORT}..."
start=${SECONDS}
until (exec 3<>"/dev/tcp/${HOST}/${PORT}") 2>/dev/null; do
    if ! kill -0 "${server_pid}" 2>/dev/null; then
        echo "[ERROR] Policy server exited during startup. Last lines of ${SERVER_LOG}:" >&2
        tail -n 50 "${SERVER_LOG}" >&2
        exit 1
    fi
    if (( SECONDS - start > SERVER_TIMEOUT )); then
        echo "[ERROR] Policy server not listening after ${SERVER_TIMEOUT}s." >&2
        tail -n 50 "${SERVER_LOG}" >&2
        exit 1
    fi
    sleep 5
done
echo "[INFO] Policy server up after $((SECONDS - start))s."

# ── RoboTwin client, restarted if the simulator hangs ────────────────────────
# gpu_id 0 is the first GPU of this job's allocation (SLURM renumbers them).
set +e
bash jobs/sim_watchdog.sh "jobs/logs/${SLURM_JOB_NAME:-test_wam_dsrl}_${SLURM_JOB_ID:-local}" "${EPISODES}" \
    bash dsrl/data/robotwin/rollout.sh "${TASK}" "${TASK_CONFIG}" 0 "${PORT}" "${HOST}"
status=$?
set -e

echo "[INFO] RoboTwin client exited with status ${status}"
echo "[INFO] RoboTwin results: ${ROBOTWIN_PATH}/eval_result/"
exit "${status}"
